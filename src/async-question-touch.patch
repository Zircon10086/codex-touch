+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::app_event_sender::AppEventSender;
+    use crossterm::event::MouseButton;
+    use crossterm::event::MouseEvent;
+    use crossterm::event::MouseEventKind;
+    use tokio::sync::mpsc::unbounded_channel;
+
+    fn fixture() -> ChatComposer {
+        let (tx, _) = unbounded_channel();
+        let mut composer =
+            ChatComposer::new(true, AppEventSender::new(tx), false, "Test".into(), true);
+        composer.footer.shortcut_touch.get_mut().enabled = true;
+        composer
+    }
+
+    fn draw(composer: &ChatComposer, width: u16, options: ComposerRenderOptions<'_>) -> Buffer {
+        let area = Rect::new(0, 0, width, 60);
+        let mut buf = Buffer::empty(area);
+        composer.render_with_options(area, &mut buf, None, options);
+        buf
+    }
+
+    fn position(buf: &Buffer, label: &str) -> (u16, u16) {
+        for y in buf.area.y..buf.area.bottom() {
+            for x in buf.area.x..buf.area.right() {
+                let text: String = (x..buf.area.right())
+                    .map(|column| buf[(column, y)].symbol())
+                    .collect();
+                if text.starts_with(label) {
+                    return (x, y);
+                }
+            }
+        }
+        panic!("missing {label}");
+    }
+
+    fn tap(composer: &mut ChatComposer, pos: (u16, u16)) -> Outcome {
+        let event = |kind| MouseEvent {
+            kind,
+            column: pos.0,
+            row: pos.1,
+            modifiers: KeyModifiers::NONE,
+        };
+        assert_eq!(
+            composer.handle_shortcut_touch(event(MouseEventKind::Down(MouseButton::Left))),
+            Outcome::Consumed
+        );
+        composer.handle_shortcut_touch(event(MouseEventKind::Up(MouseButton::Left)))
+    }
+
+    #[test]
+    fn shortcut_touch_opens_help_with_draft_and_newline_uses_editor_binding() {
+        let mut composer = fixture();
+        composer.draft.textarea.insert_str("草稿");
+        let buf = draw(&composer, 100, ComposerRenderOptions::default());
+        assert_eq!(
+            tap(&mut composer, position(&buf, "for shortcuts")),
+            Outcome::Consumed
+        );
+        assert!(composer.shortcut_overlay_visible());
+        let buf = draw(&composer, 100, ComposerRenderOptions::default());
+        let outcome = tap(&mut composer, position(&buf, "New line"));
+        assert!(!composer.shortcut_overlay_visible());
+        let Outcome::Activate(Action::Keys(crate::key_hint::ShortcutHint::Single(key))) = outcome
+        else {
+            panic!("{outcome:?}")
+        };
+        let (code, modifiers) = key.parts();
+        let (result, _) = composer.handle_key_event(KeyEvent::new(code, modifiers));
+        assert!(matches!(result, InputResult::None));
+        assert_eq!(composer.draft.textarea.text(), "草稿\n");
+    }
+
+    #[test]
+    fn shortcut_touch_close_preserves_draft_and_hidden_owners_have_no_targets() {
+        let mut composer = fixture();
+        composer.draft.textarea.insert_str("retained");
+        composer.footer.mode = FooterMode::ShortcutOverlay;
+        let buf = draw(&composer, 80, ComposerRenderOptions::default());
+        assert_eq!(
+            tap(&mut composer, position(&buf, "close")),
+            Outcome::Consumed
+        );
+        assert!(!composer.shortcut_overlay_visible());
+        assert_eq!(composer.draft.textarea.text(), "retained");
+        for options in [
+            ComposerRenderOptions {
+                unfocused: true,
+                ..Default::default()
+            },
+            ComposerRenderOptions {
+                is_dialog_backdrop: true,
+                ..Default::default()
+            },
+        ] {
+            draw(&composer, 80, options);
+            assert!(!composer.shortcut_touch_active());
+        }
+    }
+
+    #[test]
+    fn shortcut_touch_keymap_and_double_escape_keep_the_draft() {
+        let mut composer = fixture();
+        composer.draft.textarea.insert_str("retained");
+        composer.footer.mode = FooterMode::ShortcutOverlay;
+        let buf = draw(&composer, 100, ComposerRenderOptions::default());
+        assert_eq!(
+            tap(&mut composer, position(&buf, "/keymap")),
+            Outcome::Activate(Action::Keymap)
+        );
+        assert_eq!(composer.draft.textarea.text(), "retained");
+        composer.footer.mode = FooterMode::ShortcutOverlay;
+        let buf = draw(&composer, 100, ComposerRenderOptions::default());
+        let result = tap(&mut composer, position(&buf, "Edit last message"));
+        let Outcome::Activate(Action::Keys(crate::key_hint::ShortcutHint::Chord {
+            prefix,
+            completion,
+        })) = result
+        else {
+            panic!("expected double escape, got {result:?}");
+        };
+        assert_eq!(prefix, completion);
+        assert_eq!(composer.draft.textarea.text(), "retained");
+    }
+
+    #[test]
+    fn shortcut_touch_transcript_footer_keeps_help_clickable() {
+        let mut composer = fixture();
+        let footer = crate::bottom_pane::chat_composer::footer_state::TranscriptFooter {
+            text: ratatui::text::Text::from("esc latest"),
+            cursor_column: None,
+            is_interactive: false,
+        };
+        let buf = draw(
+            &composer,
+            100,
+            ComposerRenderOptions {
+                footer: Some(&footer),
+                ..Default::default()
+            },
+        );
+        assert_eq!(
+            tap(&mut composer, position(&buf, "shortcuts")),
+            Outcome::Consumed
+        );
+        assert!(composer.shortcut_overlay_visible());
+    }
+
+    #[test]
+    fn shortcut_touch_narrow_draft_keeps_newline_clickable() {
+        let mut composer = fixture();
+        composer.draft.textarea.insert_str("草稿");
+        for width in [24, 42, 80] {
+            let buf = draw(&composer, width, ComposerRenderOptions::default());
+            let outcome = tap(&mut composer, position(&buf, "new line"));
+            assert_eq!(
+                outcome,
+                Outcome::Activate(Action::Keys(composer.footer.insert_newline_key.unwrap()))
+            );
+        }
+    }
+}
