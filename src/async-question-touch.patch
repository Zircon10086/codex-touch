@@ -0,0 +1,282 @@
+//! Opt-in taps on rendered shortcut hints. Owners provide semantic actions and
+//! actual painted rectangles; no displayed key label is parsed back into input.
+//! A gesture stays captured until release, even after cancellation, so dragging
+//! a hint cannot start a selection or activate content revealed underneath it.
+
+use crate::key_hint::KeyBinding;
+use crate::key_hint::ShortcutHint;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+use crossterm::event::MouseButton;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use ratatui::layout::Rect;
+
+/// Mirror crossterm's Shift+Tab decoding for handlers matching BackTab directly.
+pub(crate) fn key_event(binding: KeyBinding, kind: KeyEventKind) -> KeyEvent {
+    let (mut code, modifiers) = binding.parts();
+    if code == KeyCode::Tab && modifiers.contains(KeyModifiers::SHIFT) {
+        code = KeyCode::BackTab;
+    }
+    KeyEvent::new_with_kind(code, modifiers, kind)
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Action {
+    Keys(ShortcutHint),
+    Help,
+    Close,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Target<A = Action> {
+    pub(crate) areas: Vec<Rect>,
+    pub(crate) action: A,
+}
+
+impl<A> Target<A> {
+    pub(crate) fn new(area: Rect, action: A) -> Self {
+        Self {
+            areas: vec![area],
+            action,
+        }
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Outcome<A = Action> {
+    Ignored,
+    Consumed,
+    Activate(A),
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct ShortcutTouch<A = Action> {
+    pub(crate) enabled: bool,
+    area: Rect,
+    targets: Vec<Target<A>>,
+    pressed: Option<usize>,
+    captured: bool,
+}
+
+impl<A> Default for ShortcutTouch<A> {
+    fn default() -> Self {
+        Self {
+            enabled: false,
+            area: Rect::default(),
+            targets: Vec::new(),
+            pressed: None,
+            captured: false,
+        }
+    }
+}
+
+impl<A: Copy + Eq> ShortcutTouch<A> {
+    pub(crate) fn new() -> Self {
+        Self {
+            enabled: std::env::var("CODEX_TOUCH").is_ok_and(|value| value == "1"),
+            ..Self::default()
+        }
+    }
+
+    pub(crate) fn set_layout(&mut self, area: Rect, targets: Vec<Target<A>>) {
+        if self.area != area || self.targets != targets {
+            self.cancel();
+        }
+        self.area = area;
+        self.targets = targets;
+    }
+
+    pub(crate) fn active(&self) -> bool {
+        self.enabled && (self.captured || !self.targets.is_empty())
+    }
+
+    pub(crate) fn cancel(&mut self) {
+        self.pressed = None;
+    }
+
+    pub(crate) fn clear(&mut self) {
+        self.cancel();
+        self.targets.clear();
+    }
+
+    pub(crate) fn handle(&mut self, mouse: MouseEvent) -> Outcome<A> {
+        if !self.enabled {
+            return Outcome::Ignored;
+        }
+        let hit = self.targets.iter().position(|target| {
+            target
+                .areas
+                .iter()
+                .any(|area| area.contains((mouse.column, mouse.row).into()))
+        });
+        if !mouse.modifiers.is_empty() {
+            self.cancel();
+        }
+        match mouse.kind {
+            MouseEventKind::Down(MouseButton::Left) => {
+                self.pressed = hit.filter(|_| mouse.modifiers.is_empty());
+                self.captured = self.pressed.is_some();
+                if self.captured {
+                    Outcome::Consumed
+                } else {
+                    Outcome::Ignored
+                }
+            }
+            MouseEventKind::Up(MouseButton::Left) => {
+                let pressed = self.pressed.take();
+                let captured = std::mem::take(&mut self.captured);
+                if let Some(index) = pressed.filter(|index| Some(*index) == hit) {
+                    Outcome::Activate(self.targets[index].action)
+                } else if captured {
+                    Outcome::Consumed
+                } else {
+                    Outcome::Ignored
+                }
+            }
+            MouseEventKind::Moved => {
+                if self.pressed != hit {
+                    self.cancel();
+                }
+                if self.captured {
+                    Outcome::Consumed
+                } else {
+                    Outcome::Ignored
+                }
+            }
+            _ => {
+                self.cancel();
+                if self.captured {
+                    Outcome::Consumed
+                } else {
+                    Outcome::Ignored
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::key_hint;
+    use crossterm::event::KeyCode;
+    use crossterm::event::KeyModifiers;
+
+    fn mouse(kind: MouseEventKind, column: u16, row: u16) -> MouseEvent {
+        MouseEvent {
+            kind,
+            column,
+            row,
+            modifiers: KeyModifiers::NONE,
+        }
+    }
+
+    fn fixture() -> (ShortcutTouch, Target) {
+        let target = Target::new(
+            Rect::new(5, 3, 12, 1),
+            Action::Keys(key_hint::shift(KeyCode::Tab).into()),
+        );
+        let mut state = ShortcutTouch {
+            enabled: true,
+            ..ShortcutTouch::default()
+        };
+        state.set_layout(Rect::new(0, 0, 60, 8), vec![target.clone()]);
+        (state, target)
+    }
+
+    #[test]
+    fn stationary_release_activates_once_and_does_not_include_padding() {
+        let (mut state, target) = fixture();
+        assert_eq!(
+            state.handle(mouse(MouseEventKind::Down(MouseButton::Left), 16, 3)),
+            Outcome::Consumed
+        );
+        assert_eq!(
+            state.handle(mouse(MouseEventKind::Up(MouseButton::Left), 16, 3)),
+            Outcome::Activate(target.action)
+        );
+        assert_eq!(
+            state.handle(mouse(MouseEventKind::Up(MouseButton::Left), 16, 3)),
+            Outcome::Ignored
+        );
+        assert_eq!(
+            state.handle(mouse(MouseEventKind::Down(MouseButton::Left), 17, 3)),
+            Outcome::Ignored
+        );
+        assert_eq!(
+            state.handle(mouse(MouseEventKind::Up(MouseButton::Left), 16, 3)),
+            Outcome::Ignored
+        );
+    }
+
+    #[test]
+    fn drag_modifiers_wheel_and_leaving_then_returning_cancel_activation() {
+        for kind in [
+            MouseEventKind::Drag(MouseButton::Left),
+            MouseEventKind::ScrollDown,
+            MouseEventKind::Moved,
+        ] {
+            let (mut state, _) = fixture();
+            state.handle(mouse(MouseEventKind::Down(MouseButton::Left), 5, 3));
+            assert_eq!(state.handle(mouse(kind, 50, 3)), Outcome::Consumed);
+            assert_eq!(
+                state.handle(mouse(MouseEventKind::Up(MouseButton::Left), 5, 3)),
+                Outcome::Consumed
+            );
+        }
+        let (mut state, _) = fixture();
+        state.handle(mouse(MouseEventKind::Down(MouseButton::Left), 5, 3));
+        let mut release = mouse(MouseEventKind::Up(MouseButton::Left), 5, 3);
+        release.modifiers = KeyModifiers::SHIFT;
+        assert_eq!(state.handle(release), Outcome::Consumed);
+    }
+
+    #[test]
+    fn repaint_preserves_tap_but_replacement_resize_and_input_cancel_it() {
+        let area = Rect::new(0, 0, 60, 8);
+        for change in 0..4 {
+            let (mut state, target) = fixture();
+            state.handle(mouse(MouseEventKind::Down(MouseButton::Left), 5, 3));
+            match change {
+                0 => state.set_layout(area, vec![target.clone()]),
+                1 => state.set_layout(Rect::new(0, 0, 59, 8), vec![target.clone()]),
+                2 => state.set_layout(area, vec![Target::new(target.areas[0], Action::Close)]),
+                _ => {
+                    state.clear();
+                    state.set_layout(area, vec![target.clone()]);
+                }
+            }
+            assert_eq!(
+                state.handle(mouse(MouseEventKind::Up(MouseButton::Left), 5, 3)),
+                if change == 0 {
+                    Outcome::Activate(target.action)
+                } else {
+                    Outcome::Consumed
+                }
+            );
+        }
+    }
+
+    #[test]
+    fn shift_tab_uses_terminal_backtab_for_press_and_release() {
+        for kind in [KeyEventKind::Press, KeyEventKind::Release] {
+            let event = key_event(crate::key_hint::shift(KeyCode::Tab), kind);
+            assert_eq!(event.code, KeyCode::BackTab);
+            assert_eq!(event.kind, kind);
+            assert_eq!(event.modifiers, KeyModifiers::SHIFT);
+        }
+    }
+
+    #[test]
+    fn opt_in_is_required() {
+        let (mut state, _) = fixture();
+        state.enabled = false;
+        assert_eq!(
+            state.handle(mouse(MouseEventKind::Down(MouseButton::Left), 5, 3)),
+            Outcome::Ignored
+        );
+    }
+}
