diff --git a/codex-rs/tui/src/app/agent_center/touch.rs b/codex-rs/tui/src/app/agent_center/touch.rs
new file mode 100644
index 0000000..c71f9e3
--- /dev/null
+++ b/codex-rs/tui/src/app/agent_center/touch.rs
@@ -0,0 +1,135 @@
+//! Hit regions are collected by the painter. Stable task IDs prevent refreshes
+//! from redirecting a tap to a different task; only the active view receives input.
+use super::*;
+use crate::shortcut_help::HelpRow;
+use crate::shortcut_touch::Action;
+use crate::shortcut_touch::Outcome;
+use crate::shortcut_touch::Target;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(in crate::app::agents_overview_view) enum CenterAction {
+    Keys(ShortcutHint, bool),
+    Task(ThreadId, bool),
+    More(bool),
+    Filter(usize),
+}
+
+pub(super) fn render_hint(
+    row: HelpRow,
+    area: Rect,
+    buf: &mut Buffer,
+    targets: &mut Vec<Target<CenterAction>>,
+    close_help: bool,
+) {
+    if area.is_empty() {
+        return;
+    }
+    let width = crate::line_truncation::line_width(&row.line);
+    let visible =
+        usize::from(area.width).saturating_sub(usize::from(width > usize::from(area.width)));
+    let (lines, hints) = crate::shortcut_help::wrap_rows(vec![row], width.max(1));
+    for hint in hints {
+        if hint
+            .areas
+            .iter()
+            .all(|r| r.y == 0 && usize::from(r.right()) <= visible)
+        {
+            let Action::Keys(key) = hint.action else {
+                continue;
+            };
+            targets.push(Target {
+                areas: hint
+                    .areas
+                    .into_iter()
+                    .map(|r| Rect::new(area.x + r.x, area.y, r.width, 1))
+                    .collect(),
+                action: CenterAction::Keys(key, close_help),
+            });
+        }
+    }
+    if let Some(line) = lines.into_iter().next() {
+        super::render::line(line, area, buf);
+    }
+}
+
+impl AgentsOverviewView {
+    pub(in crate::app::agents_overview_view) fn handle_center_touch(
+        &mut self,
+        event: MouseEvent,
+    ) -> Outcome {
+        let mut state = self.state();
+        if !state.touch.enabled {
+            return Outcome::Ignored;
+        }
+        let outcome = state.touch.handle(event);
+        if matches!(outcome, Outcome::Ignored)
+            && !state.help
+            && state.rename_target.is_none()
+            && event.modifiers.is_empty()
+            && state.touch_list.contains((event.column, event.row).into())
+            && matches!(
+                event.kind,
+                MouseEventKind::ScrollUp | MouseEventKind::ScrollDown
+            )
+        {
+            drop(state);
+            self.move_selection(event.kind == MouseEventKind::ScrollDown);
+            return Outcome::Consumed;
+        }
+        let action = match outcome {
+            Outcome::Ignored => return Outcome::Ignored,
+            Outcome::Consumed => return Outcome::Consumed,
+            Outcome::Activate(action) => action,
+        };
+        state.touch.clear();
+        match action {
+            CenterAction::Keys(hint, close_help) => {
+                if close_help {
+                    state.help = false;
+                }
+                return Outcome::Activate(Action::Keys(hint));
+            }
+            CenterAction::Filter(index) => {
+                if state.editing_metadata() {
+                    return Outcome::Consumed;
+                }
+                state.help = false;
+                state.status_filter = index;
+                state.scroll = 0;
+                drop(state);
+                self.reconcile_command_center_selection();
+            }
+            CenterAction::Task(_, _) | CenterAction::More(_) => {
+                if state.help || state.rename_target.is_some() {
+                    return Outcome::Consumed;
+                }
+                drop(state);
+                let (index, was_selected) = match action {
+                    CenterAction::Task(id, selected) => {
+                        let Some(index) = self.rows.iter().position(|row| row.thread_id == id)
+                        else {
+                            return Outcome::Consumed;
+                        };
+                        (index, selected)
+                    }
+                    CenterAction::More(selected) => (usize::MAX, selected),
+                    _ => unreachable!(),
+                };
+                if !self.selectable_indices().contains(&index) {
+                    return Outcome::Consumed;
+                }
+                let open = was_selected && self.selected == index;
+                self.selected = index;
+                self.state().show_more_selected = index == usize::MAX;
+                // Re-enter the application key route, preserving connection guards,
+                // search/rename semantics, configured chords and dispatch tokens.
+                if open && let Some(hint) = self.center_list_hint(ListAction::Accept) {
+                    return Outcome::Activate(Action::Keys(hint));
+                }
+            }
+        }
+        Outcome::Consumed
+    }
+}
