--- /dev/null
+++ b/codex-rs/tui/src/resume_picker/touch.rs
@@ -0,0 +1,425 @@
+//! Touch uses the same row geometry, toolbar values, and runtime keys as the picker.
+use super::*;
+use crate::key_hint::ShortcutHint;
+use crate::shortcut_touch::Outcome;
+use crate::shortcut_touch::Target;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Action {
+    Row(BackendId, ThreadId, bool),
+    Keys(ShortcutHint),
+    Cycle(ToolbarControl),
+    Filter(SessionFilterMode),
+    Status(SessionStatus),
+    Sort(bool),
+}
+
+impl PickerState {
+    pub(super) async fn handle_touch(
+        &mut self,
+        mouse: MouseEvent,
+    ) -> Result<Option<SessionSelection>> {
+        if !self.touch.borrow().enabled {
+            return Ok(None);
+        }
+        let outcome = self.touch.borrow_mut().handle(mouse);
+        let action = match outcome {
+            Outcome::Activate(action) => Some(action),
+            Outcome::Ignored
+                if matches!(
+                    mouse.kind,
+                    MouseEventKind::ScrollUp | MouseEventKind::ScrollDown
+                ) && !self.is_transcript_loading()
+                    && self.touch_targets.borrow().iter().any(|target| {
+                        matches!(target.action, Action::Row(..))
+                            && target
+                                .areas
+                                .iter()
+                                .any(|rect| rect.contains((mouse.column, mouse.row).into()))
+                    }) =>
+            {
+                let action = if mouse.kind == MouseEventKind::ScrollUp {
+                    ListAction::MoveUp
+                } else {
+                    ListAction::MoveDown
+                };
+                self.keymap.list.primary_hint(action).map(Action::Keys)
+            }
+            _ => None,
+        };
+        let Some(action) = action else {
+            return Ok(None);
+        };
+        match action {
+            Action::Row(backend, id, selected) => {
+                if let Some(index) = self.filtered_rows.iter().position(|row| {
+                    row.thread_id == Some(id)
+                        && row.backend_id.unwrap_or(self.backend_id) == backend
+                }) {
+                    if selected && index == self.selected {
+                        if let Some(key) = self.keymap.list.primary_hint(ListAction::Accept) {
+                            return self.touch_keys(key).await;
+                        }
+                    } else {
+                        self.selected = index;
+                        self.ensure_selected_visible();
+                    }
+                }
+            }
+            Action::Keys(keys) => return self.touch_keys(keys).await,
+            Action::Cycle(control) => {
+                self.toolbar_focus = control;
+                self.change_focused_toolbar_value(ToolbarValueDirection::Next);
+            }
+            Action::Filter(value) => {
+                self.toolbar_focus = ToolbarControl::Filter;
+                for _ in 0..3 {
+                    if self.filter_mode == value {
+                        break;
+                    }
+                    self.change_focused_toolbar_value(ToolbarValueDirection::Next);
+                }
+            }
+            Action::Status(value) => {
+                self.toolbar_focus = ToolbarControl::Status;
+                if self.status != value {
+                    self.change_focused_toolbar_value(ToolbarValueDirection::Next);
+                }
+            }
+            Action::Sort(value) => {
+                self.toolbar_focus = ToolbarControl::Sort;
+                if (self.sort_key == ThreadSortKey::CreatedAt) != value {
+                    self.change_focused_toolbar_value(ToolbarValueDirection::Next);
+                }
+            }
+        }
+        self.touch.borrow_mut().clear();
+        self.request_frame();
+        Ok(None)
+    }
+
+    async fn touch_keys(&mut self, hint: ShortcutHint) -> Result<Option<SessionSelection>> {
+        self.chord_matcher.cancel();
+        self.touch.borrow_mut().clear();
+        let keys = match hint {
+            ShortcutHint::Single(key) => vec![key],
+            ShortcutHint::Chord { prefix, completion } => vec![prefix, completion],
+        };
+        for key in keys {
+            for kind in [KeyEventKind::Press, KeyEventKind::Release] {
+                if let Some(key) = self.route_key_chord(crate::shortcut_touch::key_event(key, kind))
+                    && key.kind != KeyEventKind::Release
+                    && let Some(selection) = self.handle_key(key).await?
+                {
+                    return Ok(Some(selection));
+                }
+            }
+        }
+        self.request_frame();
+        Ok(None)
+    }
+}
+
+pub(super) fn register_list_hint(state: &PickerState, area: Rect, action: ListAction) {
+    if let Some(key) = state.keymap.list.primary_hint(action) {
+        state
+            .touch_targets
+            .borrow_mut()
+            .push(Target::new(area, Action::Keys(key)));
+    }
+}
+
+pub(super) fn register_footer(
+    state: &PickerState,
+    row: &crate::shortcut_help::HelpRow,
+    area: Rect,
+) {
+    let text = row.line.to_string();
+    for (range, key) in &row.hints {
+        let x = UnicodeWidthStr::width(&text[..range.start]) as u16;
+        let width = UnicodeWidthStr::width(&text[range.clone()]) as u16;
+        if width > 0 && x.saturating_add(width) <= area.width {
+            state.touch_targets.borrow_mut().push(Target::new(
+                Rect::new(area.x + x, area.y, width, 1),
+                Action::Keys(*key),
+            ));
+        }
+    }
+}
+
+pub(super) fn toolbar(state: &PickerState, area: Rect) -> (Line<'static>, Vec<Target<Action>>) {
+    let wide = toolbar_line(state, false);
+    let compact = wide.width() > usize::from(area.width);
+    let only_focus = compact && toolbar_line(state, true).width() > usize::from(area.width);
+    let controls = [
+        ToolbarControl::Filter,
+        ToolbarControl::Status,
+        ToolbarControl::Sort,
+    ];
+    let mut spans = Vec::new();
+    let mut targets = Vec::new();
+    for control in controls {
+        if (only_focus && control != state.toolbar_focus)
+            || (control == ToolbarControl::Status
+                && !matches!(state.action, SessionPickerAction::Resume))
+        {
+            continue;
+        }
+        if !spans.is_empty() {
+            spans.push(Span::styled(
+                if compact && matches!(state.action, SessionPickerAction::Resume) {
+                    " "
+                } else {
+                    "   "
+                },
+                secondary_text_style(),
+            ));
+        }
+        let (parts, actions) = match control {
+            ToolbarControl::Filter => {
+                let parts = filter_control_spans(state, compact);
+                let actions = if compact || state.filter_cwd.is_none() {
+                    vec![None, Some(Action::Cycle(control))]
+                } else {
+                    let mut actions = vec![None, Some(Action::Filter(SessionFilterMode::Cwd))];
+                    if state.repo_filter_available {
+                        actions.push(Some(Action::Filter(SessionFilterMode::Repo)));
+                    }
+                    actions.push(Some(Action::Filter(SessionFilterMode::All)));
+                    actions
+                };
+                (parts, actions)
+            }
+            ToolbarControl::Sort => (
+                sort_control_spans(state, compact),
+                if compact {
+                    vec![None, Some(Action::Cycle(control))]
+                } else {
+                    vec![None, Some(Action::Sort(false)), Some(Action::Sort(true))]
+                },
+            ),
+            ToolbarControl::Status => {
+                let focused = state.toolbar_focus == control;
+                if compact {
+                    let mut parts = Vec::new();
+                    let mut actions = Vec::new();
+                    if only_focus {
+                        parts.push(Span::styled("Status:", secondary_text_style()));
+                        actions.push(None);
+                    }
+                    parts.push(toolbar_value(
+                        if state.status == SessionStatus::Active {
+                            "Active"
+                        } else {
+                            "Archived"
+                        },
+                        true,
+                        focused,
+                    ));
+                    actions.push(Some(Action::Cycle(control)));
+                    (parts, actions)
+                } else {
+                    (
+                        vec![
+                            Span::styled("Status: ", secondary_text_style()),
+                            toolbar_value("Active", state.status == SessionStatus::Active, focused),
+                            toolbar_value(
+                                "Archived",
+                                state.status == SessionStatus::Archived,
+                                focused,
+                            ),
+                        ],
+                        vec![
+                            None,
+                            Some(Action::Status(SessionStatus::Active)),
+                            Some(Action::Status(SessionStatus::Archived)),
+                        ],
+                    )
+                }
+            }
+        };
+        for (part, action) in parts.into_iter().zip(actions) {
+            let x = spans.iter().map(Span::width).sum::<usize>();
+            if let Some(action) = action
+                && x + part.width() <= usize::from(area.width)
+                && area.height > 0
+            {
+                targets.push(Target::new(
+                    Rect::new(area.x + x as u16, area.y, part.width() as u16, 1),
+                    action,
+                ));
+            }
+            spans.push(part);
+        }
+    }
+    (Line::from(spans), targets)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::custom_terminal::Terminal;
+    use crate::test_backend::VT100Backend;
+    use crossterm::event::MouseButton;
+
+    fn fixture() -> PickerState {
+        let mut state = super::super::tests::local_db_first_state().0;
+        state.touch.borrow_mut().enabled = true;
+        state.filtered_rows = (0..4)
+            .map(|index| {
+                let mut row = super::super::tests::make_row(
+                    "/tmp/touch-synthetic",
+                    "2026-11-18T00:00:00Z",
+                    &format!("Synthetic session {index}"),
+                );
+                row.thread_id = Some(ThreadId::new());
+                row
+            })
+            .collect();
+        state
+    }
+    fn paint(state: &PickerState, width: u16, height: u16) {
+        let mut terminal = Terminal::with_options(VT100Backend::new(width, height)).unwrap();
+        terminal.set_viewport_area(Rect::new(0, 0, width, height));
+        layout::render(&mut terminal.get_frame(), state);
+    }
+    fn mouse(kind: MouseEventKind, area: Rect) -> MouseEvent {
+        MouseEvent {
+            kind,
+            column: area.x,
+            row: area.y,
+            modifiers: KeyModifiers::NONE,
+        }
+    }
+    async fn tap(
+        state: &mut PickerState,
+        action: impl Fn(Action) -> bool,
+    ) -> Option<SessionSelection> {
+        let target = state
+            .touch_targets
+            .borrow()
+            .iter()
+            .find(|target| action(target.action))
+            .unwrap()
+            .areas[0];
+        assert!(
+            state
+                .handle_touch(mouse(MouseEventKind::Down(MouseButton::Left), target))
+                .await
+                .unwrap()
+                .is_none()
+        );
+        state
+            .handle_touch(mouse(MouseEventKind::Up(MouseButton::Left), target))
+            .await
+            .unwrap()
+    }
+    #[tokio::test]
+    async fn row_select_then_resume_or_fork_preserves_thread_identity() {
+        for action in [SessionPickerAction::Resume, SessionPickerAction::Fork] {
+            let mut state = fixture();
+            state.action = action;
+            let expected = state.filtered_rows[1].thread_id.unwrap();
+            paint(&state, 110, 38);
+            assert!(
+                tap(
+                    &mut state,
+                    |a| matches!(a,Action::Row(_,id,_) if id==expected)
+                )
+                .await
+                .is_none()
+            );
+            assert_eq!(state.selected, 1);
+            paint(&state, 110, 38);
+            let selected = tap(
+                &mut state,
+                |a| matches!(a,Action::Row(_,id,_) if id==expected),
+            )
+            .await
+            .unwrap();
+            match (action, selected) {
+                (SessionPickerAction::Resume, SessionSelection::Resume(row))
+                | (SessionPickerAction::Fork, SessionSelection::Fork(row)) => {
+                    assert_eq!(row.thread_id, expected)
+                }
+                _ => panic!("Wrong picker selection"),
+            }
+        }
+    }
+    #[tokio::test]
+    async fn repaint_resize_reorder_and_drag_do_not_resume_a_stale_row() {
+        for change in 0..3 {
+            let mut state = fixture();
+            paint(&state, 110, 38);
+            let area = state
+                .touch_targets
+                .borrow()
+                .iter()
+                .find(|t| matches!(t.action, Action::Row(_, _, true)))
+                .unwrap()
+                .areas[0];
+            state
+                .handle_touch(mouse(MouseEventKind::Down(MouseButton::Left), area))
+                .await
+                .unwrap();
+            match change {
+                0 => paint(&state, 42, 32),
+                1 => {
+                    state.filtered_rows.swap(0, 1);
+                    paint(&state, 110, 38);
+                }
+                _ => {
+                    state
+                        .handle_touch(mouse(MouseEventKind::Drag(MouseButton::Left), area))
+                        .await
+                        .unwrap();
+                }
+            }
+            assert!(
+                state
+                    .handle_touch(mouse(MouseEventKind::Up(MouseButton::Left), area))
+                    .await
+                    .unwrap()
+                    .is_none()
+            );
+        }
+    }
+    #[test]
+    fn toolbar_geometry_matches_existing_display_at_all_widths() {
+        let mut state = fixture();
+        state.filter_cwd = Some(PathBuf::from("/tmp"));
+        state.repo_filter_available = true;
+        for width in 1..180 {
+            for focus in [
+                ToolbarControl::Filter,
+                ToolbarControl::Status,
+                ToolbarControl::Sort,
+            ] {
+                state.toolbar_focus = focus;
+                let (line, targets) = toolbar(&state, Rect::new(3, 4, width, 1));
+                assert_eq!(line, toolbar_for_width(&state, width));
+                assert!(targets.iter().all(|t| t.areas[0].right() <= 3 + width));
