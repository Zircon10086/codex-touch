+    let buf = touch_draw(&view, 100, 30);
+    touch_dispatch(&mut view, touch_position(&buf, "? help"));
+    let buf = touch_draw(&view, 100, 30);
+    touch_dispatch(&mut view, touch_position(&buf, "Rename"));
+    let buf = touch_draw(&view, 100, 30);
+    assert!(touch_position(&buf, "Rename ›").1 > 0);
+    view.handle_key_event(KeyCode::Esc.into());
+    let buf = touch_draw(&view, 100, 30);
+    touch_dispatch(&mut view, touch_position(&buf, "? help"));
+    let buf = touch_draw(&view, 100, 30);
+    touch_dispatch(&mut view, touch_position(&buf, "esc back"));
+    assert!(!view.is_complete());
+    let buf = touch_draw(&view, 100, 30);
+    touch_dispatch(&mut view, touch_position(&buf, "esc back"));
+    assert!(view.is_complete());
+}
