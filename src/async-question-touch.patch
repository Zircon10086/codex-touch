+            assert_answer(ops.try_recv().unwrap(), "> First?\n\nTouch choice");
+        } else if mode == 1 {
+            assert_eq!(
+                chat.pop_latest_queued_composer_state().unwrap().text,
+                "> First?\n\nTouch choice"
+            );
+            assert!(ops.try_recv().is_err());
+        } else {
+            assert!(ops.try_recv().is_err());
+        }
+        // The release that delivered the first answer cannot act on the next question.
+        touch_question_at(&chat, if mode == 2 { "Touch choice" } else { "Second?" });
+        chat.handle_question_mouse(MouseEvent {
+            kind: MouseEventKind::Up(MouseButton::Left),
+            column,
+            row,
+            modifiers: KeyModifiers::NONE,
+        });
+        assert!(ops.try_recv().is_err());
+    }
+}
