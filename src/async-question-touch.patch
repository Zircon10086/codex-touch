@@ -0,0 +1,187 @@
+//! Opt-in touch routing for async questions. Rendering owns hit regions; a release
+//! activates only the same target pressed in an unchanged layout and question.
+use super::*;
+use crate::key_hint::ShortcutHint;
+use crossterm::event::MouseButton;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use ratatui::layout::Rect;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) enum Target {
+    Expand,
+    Option(usize),
+    Input,
+    Key(crate::key_hint::KeyBinding),
+}
+
+#[derive(Default, PartialEq, Eq)]
+pub(super) struct TouchLayout {
+    pub(super) question_id: String,
+    pub(super) count: usize,
+    pub(super) expanded: bool,
+    pub(super) area: Rect,
+    pub(super) targets: Vec<(Rect, Target)>,
+}
+
+#[derive(Default)]
+pub(super) struct TouchState {
+    layout: TouchLayout,
+    pressed: Option<Target>,
+    editing: bool,
+}
+
+impl AsyncQuestions {
+    pub(super) fn touch_layout(&self, area: Rect) -> TouchLayout {
+        TouchLayout {
+            question_id: self
+                .current_answer()
+                .map(|q| q.question_id.clone())
+                .unwrap_or_default(),
+            count: self.unanswered_count(),
+            expanded: self.expanded,
+            area,
+            targets: Vec::new(),
+        }
+    }
+
+    pub(super) fn set_touch_layout(&self, layout: TouchLayout) {
+        if !self.touch_enabled {
+            return;
+        }
+        let mut touch = self.touch.borrow_mut();
+        if touch.layout != layout {
+            touch.pressed = None;
+            touch.editing = false;
+        }
+        touch.layout = layout;
+    }
+
+    pub(crate) fn hide_touch(&self) {
+        *self.touch.borrow_mut() = TouchState::default();
+    }
+
+    pub(crate) fn render_touch_summary(&self, area: Rect) {
+        let mut layout = self.touch_layout(area);
+        if !area.is_empty() {
+            layout.targets.push((area, Target::Expand));
+        }
+        self.set_touch_layout(layout);
+    }
+
+    pub(crate) fn cancel_touch(&mut self) {
+        let touch = self.touch.get_mut();
+        touch.pressed = None;
+        touch.editing = false;
+        self.composer.end_mouse_drag();
+    }
+
+    pub(crate) fn invalidate_touch(&mut self) {
+        self.cancel_touch();
+        *self.touch.get_mut() = TouchState::default();
+    }
+
+    pub(crate) fn prepare_touch(&mut self, event: MouseEvent) {
+        if self.focus_is_notes() {
+            self.composer.prepare_mouse(event);
+        }
+    }
+
+    pub(crate) fn handle_touch(&mut self, event: MouseEvent) -> bool {
+        if !self.touch_enabled || self.is_complete() {
+            return false;
+        }
+        let touch = self.touch.borrow();
+        if touch.layout.expanded != self.expanded
+            || self
+                .current_answer()
+                .is_none_or(|q| q.question_id != touch.layout.question_id)
+        {
+            return false;
+        }
+        let inside = touch.layout.area.contains((event.column, event.row).into());
+        let target = touch
+            .layout
+            .targets
+            .iter()
+            .find(|(area, _)| area.contains((event.column, event.row).into()))
+            .map(|(_, target)| target.clone());
+        let owned = touch.pressed.is_some() || touch.editing;
+        drop(touch);
+        match event.kind {
+            MouseEventKind::Down(MouseButton::Left) => {
+                self.cancel_touch();
+                if inside && event.modifiers.is_empty() {
+                    self.snooze_auto_resolution();
+                    if target == Some(Target::Input) {
+                        let editing =
+                            self.composer.prepare_mouse(event) && self.composer.handle_mouse(event);
+                        self.touch.get_mut().editing = editing;
+                    } else {
+                        self.touch.get_mut().pressed = target;
+                    }
+                }
+            }
+            MouseEventKind::Up(MouseButton::Left) => {
+                if self.touch.get_mut().editing {
+                    self.composer.handle_mouse(event);
+                }
+                let pressed = self.touch.get_mut().pressed.take();
+                self.cancel_touch();
+                if event.modifiers.is_empty()
+                    && pressed == target
+                    && let Some(pressed) = pressed
+                {
+                    match pressed {
+                        Target::Expand => self.set_expanded(true),
+                        Target::Option(index) => {
+                            self.select_option(index);
+                            if self.other_selected() {
+                                self.composer.resume_text_entry();
+                            } else {
+                                self.go_next_or_submit();
+                            }
+                        }
+                        Target::Key(binding) => {
+                            let (code, modifiers) = binding.parts();
+                            self.touch_key = Some(KeyEvent::new(code, modifiers));
+                        }
+                        Target::Input => {}
+                    }
+                }
+            }
+            MouseEventKind::Drag(_) | MouseEventKind::Moved => {
+                self.touch.get_mut().pressed = None;
+                if self.touch.get_mut().editing {
+                    self.composer.handle_mouse(event);
+                }
+            }
+            MouseEventKind::ScrollUp | MouseEventKind::ScrollDown => {
+                self.cancel_touch();
+                if inside && target == Some(Target::Input) {
+                    if self.composer.prepare_mouse(event) {
+                        self.composer.handle_mouse(event);
+                    }
+                } else if inside && self.expanded && self.has_options() {
+                    self.snooze_auto_resolution();
+                    let current = self.selected_option_index().unwrap_or(0);
+                    let index = if event.kind == MouseEventKind::ScrollUp {
+                        current.saturating_sub(1)
+                    } else {
+                        (current + 1).min(self.options_len() - 1)
+                    };
+                    self.select_option(index);
+                }
+            }
+            _ => self.cancel_touch(),
+        }
+        inside || owned
+    }
+}
+
+pub(super) fn hint_target(hint: ShortcutHint) -> Option<Target> {
+    match hint {
+        ShortcutHint::Single(binding) => Some(Target::Key(binding)),
+        ShortcutHint::Chord { .. } => None,
+    }
+}
