+            overview_thread(ids[0], None, "Alpha task", ThreadStatus::Idle),
+            overview_thread(
+                ids[1],
+                None,
+                "Bravo task",
+                ThreadStatus::Active {
+                    active_flags: vec![],
+                },
+            ),
+        ],
+        Some(ids[0]),
+    );
+    view.enable_shortcut_touch_for_test();
+    let buf = touch_draw(&view, 100, 30);
+    touch_dispatch(&mut view, touch_position(&buf, "Bravo task"));
+    assert_eq!(view.rows[view.selected_index().unwrap()].thread_id, ids[1]);
+    assert!(rx.try_recv().is_err());
+    let buf = touch_draw(&view, 100, 30);
