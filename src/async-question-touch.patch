+fn shortcut_interrupt_long_header_cannot_wrap_hit_coordinates() {
+    let mut row = fixture();
+    row.update_header("x".repeat(65536));
+    draw(&row, 80);
+    assert!(!row.shortcut_touch.borrow().active());
+}
