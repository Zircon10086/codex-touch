@@ -0,0 +1,247 @@
+//! Touch regression tests use painted cells, including wrapped rows and clipped layouts.
+use super::*;
+use crate::render::renderable::Renderable;
+use crossterm::event::KeyModifiers;
+use crossterm::event::MouseButton;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+
+fn editor() -> AsyncQuestions {
+    let (tx, _rx) = tokio::sync::mpsc::unbounded_channel();
+    let mut q = AsyncQuestions::new(
+        AppEventSender::new(tx),
+        true,
+        true,
+        true,
+        RuntimeKeymap::defaults(),
+    );
+    q.touch_enabled = true;
+    q.append(
+        "touch-message",
+        &[
+            AsyncUserInputQuestion {
+                title: "Choose a route".into(),
+                options: Some(vec!["Alpha".into(), "Beta".into()]),
+            },
+            AsyncUserInputQuestion {
+                title: "Write a note".into(),
+                options: None,
+            },
+        ],
+    );
+    q.set_expanded(true);
+    q
+}
+fn render(q: &AsyncQuestions, width: u16, height: u16) -> Buffer {
+    let area = Rect::new(3, 2, width, height);
+    let mut buf = Buffer::empty(area);
+    q.render(area, &mut buf);
+    buf
+}
+fn point(buf: &Buffer, text: &str) -> (u16, u16) {
+    for y in buf.area.y..buf.area.bottom() {
+        for x in buf.area.x..buf.area.right() {
+            let suffix: String = (x..buf.area.right())
+                .map(|col| buf[(col, y)].symbol())
+                .collect();
+            if suffix.starts_with(text) {
+                return (x, y);
+            }
+        }
+    }
+    panic!("missing painted text: {text}");
+}
+
+fn event(q: &mut AsyncQuestions, pos: (u16, u16), kind: MouseEventKind) -> bool {
+    q.handle_touch(MouseEvent {
+        kind,
+        column: pos.0,
+        row: pos.1,
+        modifiers: KeyModifiers::NONE,
+    })
+}
+fn click(q: &mut AsyncQuestions, pos: (u16, u16)) {
+    assert!(event(q, pos, MouseEventKind::Down(MouseButton::Left)));
+    assert!(event(q, pos, MouseEventKind::Up(MouseButton::Left)));
+}
+fn answer(q: &mut AsyncQuestions) -> String {
+    match q.submission.take().expect("answer") {
+        QuestionSubmission::Submit(text) => text,
+        QuestionSubmission::Queue(_) => panic!("unexpected queue"),
+    }
+}
+#[test]
+fn touch_summary_opens_only_on_matching_release_and_snoozes_timeout() {
+    let mut q = editor();
+    q.set_expanded(false);
+    q.render_touch_summary(Rect::new(8, 20, 40, 2));
+    event(&mut q, (9, 20), MouseEventKind::Down(MouseButton::Left));
+    assert!(!q.expanded);
+    event(&mut q, (9, 20), MouseEventKind::Up(MouseButton::Left));
+    assert!(q.expanded);
+    assert!(q.timer_remaining(Instant::now()).is_none());
+}
+#[test]
+fn touch_painted_choice_submits_once_and_never_answers_next_question_on_release() {
+    let mut q = editor();
+    let buf = render(&q, 55, 15);
+    let pos = point(&buf, "Beta");
+    click(&mut q, pos);
+    assert!(answer(&mut q).contains("Beta"));
+    q.accept_answer();
+    render(&q, 55, 15);
+    event(&mut q, pos, MouseEventKind::Up(MouseButton::Left));
+    assert!(q.submission.is_none());
+    assert_eq!(q.unanswered_count(), 1);
+}
+#[test]
+fn touch_wrapped_unicode_choice_uses_bottom_aligned_painted_rows() {
+    let mut q = editor();
+    q.state.pending[0].question.options =
+        Some(vec!["中文问题选择 ".repeat(3) + "TAIL", "Beta".into()]);
+    let buf = render(&q, 28, 20);
+    let pos = point(&buf, "TAIL");
+    click(&mut q, pos);
+    assert!(answer(&mut q).contains("TAIL"));
+}
+#[test]
+fn touch_drag_wheel_modified_click_and_blank_space_do_not_submit() {
+    for kind in [
+        MouseEventKind::Drag(MouseButton::Left),
+        MouseEventKind::ScrollDown,
+        MouseEventKind::Moved,
+    ] {
+        let mut q = editor();
+        let buf = render(&q, 55, 15);
+        let pos = point(&buf, "Beta");
+        event(&mut q, pos, MouseEventKind::Down(MouseButton::Left));
+        event(&mut q, pos, kind);
+        render(&q, 55, 15);
+        event(&mut q, pos, MouseEventKind::Up(MouseButton::Left));
+        assert!(q.submission.is_none());
+    }
+    let mut q = editor();
+    let buf = render(&q, 55, 15);
+    let pos = point(&buf, "Beta");
+    q.handle_touch(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: pos.0,
+        row: pos.1,
+        modifiers: KeyModifiers::CONTROL,
+    });
+    event(&mut q, pos, MouseEventKind::Up(MouseButton::Left));
+    assert!(q.submission.is_none());
+    click(&mut q, (3, 2));
+    assert!(q.submission.is_none());
+}
+#[test]
+fn touch_resize_navigation_resolution_and_focus_cancel_pending_press() {
+    for mode in 0..6 {
+        let mut q = editor();
+        let buf = render(&q, 55, 15);
+        let pos = point(&buf, "Beta");
+        event(&mut q, pos, MouseEventKind::Down(MouseButton::Left));
+        match mode {
+            0 => {
+                render(&q, 30, 15);
+                render(&q, 55, 15);
+            }
+            1 => {
+                q.navigate(true);
+                q.navigate(false);
+                render(&q, 55, 15);
+            }
+            2 => {
+                q.resolve_answers(&[q.state.pending[0].question_id.clone()]);
+                render(&q, 55, 15);
+            }
+            3 => q.cancel_touch(),
+            4 => {
+                q.hide_touch();
+                render(&q, 55, 15);
+            }
+            _ => {
+                q.handle_key_event(KeyEvent::from(KeyCode::Up));
+                render(&q, 55, 15);
+            }
+        }
+        event(&mut q, pos, MouseEventKind::Up(MouseButton::Left));
+        assert!(q.submission.is_none(), "mode {mode}");
+    }
+}
+#[test]
+fn touch_clipped_option_and_disabled_delivery_cannot_submit() {
+    let mut q = editor();
+    q.state.pending[0].question.options = Some(vec!["oversized ".repeat(40)]);
+    let buf = render(&q, 28, 9);
+    let pos = point(&buf, "oversized");
+    click(&mut q, pos);
+    assert!(q.submission.is_none());
+    let mut q = editor();
+    q.delivery_enabled = false;
+    let buf = render(&q, 55, 15);
+    let pos = point(&buf, "Beta");
+    click(&mut q, pos);
+    assert!(q.submission.is_none());
+}
+#[test]
+fn touch_other_edits_existing_composer_and_footer_uses_the_existing_submit_key() {
+    let mut q = editor();
+    let buf = render(&q, 55, 15);
+    let pos = point(&buf, "Other");
+    click(&mut q, pos);
+    assert!(q.other_selected());
+    assert!(q.submission.is_none());
+    q.handle_paste("typed note".into());
+    let buf = render(&q, 55, 15);
+    let pos = point(&buf, "typed note");
+    click(&mut q, pos);
+    q.handle_key_event(KeyEvent::from(KeyCode::Char('X')));
+    assert!(q.composer.current_text().starts_with('X'));
+    let buf = render(&q, 55, 15);
+    let pos = point(&buf, "submit");
+    click(&mut q, pos);
+    let key = q.touch_key.take().expect("footer key");
+    q.handle_key_event(key);
+    assert!(answer(&mut q).contains("Xtyped note"));
+}
+#[test]
+fn touch_freeform_and_narrow_footer_keep_keyboard_queue_semantics() {
+    let mut q = editor();
+    q.navigate(true);
+    q.handle_paste("freeform".into());
+    let buf = render(&q, 24, 16);
+    let pos = point(&buf, "submit");
+    click(&mut q, pos);
+    let key = q.touch_key.take().unwrap();
+    assert!(q.keymap.composer.submit.is_pressed(key));
+    // Tab queues only while a turn is running; idle Tab submits in the upstream composer.
+    q.composer.set_task_running(true);
+    q.handle_key_event(KeyEvent::from(KeyCode::Tab));
+    assert!(
+        matches!(q.submission.take(),Some(QuestionSubmission::Queue(text)) if text.contains("freeform"))
+    );
+}
+#[test]
+fn touch_opt_out_preserves_original_mouse_behavior() {
+    let mut q = editor();
+    q.touch_enabled = false;
+    let buf = render(&q, 55, 15);
+    let pos = point(&buf, "Beta");
+    assert!(!event(&mut q, pos, MouseEventKind::Down(MouseButton::Left)));
+    assert!(q.submission.is_none());
+}
+
+#[test]
+fn touch_input_scroll_does_not_change_other_to_a_named_answer() {
+    let mut q = editor();
+    q.focus_other();
+    q.handle_paste("first\nsecond\nthird".into());
+    let buf = render(&q, 55, 15);
+    let pos = point(&buf, "second");
+    event(&mut q, pos, MouseEventKind::ScrollUp);
+    assert!(q.other_selected());
+    assert!(q.submission.is_none());
+}
