+fn shortcut_touch_tracks_wrapped_runtime_bindings_and_all_column_layouts() {
+    use ratatui::buffer::Buffer;
+    use ratatui::layout::Rect;
+    let mut props = props();
+    let hint = ShortcutHint::Chord {
+        prefix: key_hint::ctrl(KeyCode::Char('x')),
+        completion: key_hint::shift(KeyCode::Enter),
+    };
+    props.key_hints.insert_newline = Some(hint);
+    props.key_hints.history_search = None;
+    for width in [9, 28, 60, 95, 160] {
+        let area = Rect::new(4, 2, width, 200);
+        let mut buf = Buffer::empty(Rect::new(0, 0, 200, 205));
+        let targets = super::render(&props, area, &mut buf);
+        let target = targets
+            .iter()
+            .find(|t| t.action == crate::shortcut_touch::Action::Keys(hint))
+            .unwrap();
+        let painted: String = target
+            .areas
+            .iter()
+            .flat_map(|r| (r.x..r.right()).map(|x| buf[(x, r.y)].symbol()))
+            .collect();
+        assert!(
+            painted.contains("New") && painted.contains("line"),
+            "{width}: {painted}"
