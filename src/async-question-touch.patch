+#[test]
+fn touch_transcript_hint_resolves_runtime_pager_chord() {
+    use crate::touch_controls::tests::{mouse, point};
+    use crossterm::event::{MouseButton, MouseEventKind};
+    let runtime = crate::keymap::RuntimeKeymap::from_config(
+        &toml::from_str("[pager]\nfind = 'ctrl-x f3'").unwrap(),
+    )
+    .unwrap();
+    let mut overlay = TranscriptOverlay::new(Vec::new(), runtime.pager.clone());
+    overlay.enable_touch_for_test();
+    let area = Rect::new(0, 0, 100, 20);
+    let mut buf = Buffer::empty(area);
+    overlay.render(area, &mut buf);
+    let pos = point(&buf, "find");
+    assert_eq!(
+        pager_touch_key(
+            overlay.touch_for_test(),
+            &TuiEvent::Mouse(mouse(pos, MouseEventKind::Down(MouseButton::Left))),
+            &runtime.pager
+        ),
+        crate::shortcut_touch::Outcome::Consumed
+    );
+    let crate::shortcut_touch::Outcome::Activate(event) = pager_touch_key(
+        overlay.touch_for_test(),
+        &TuiEvent::Mouse(mouse(pos, MouseEventKind::Up(MouseButton::Left))),
+        &runtime.pager,
+    ) else {
+        panic!("touch did not activate find");
+    };
+    overlay.handle_key(event);
+    assert!(overlay.is_search_editing());
+}
