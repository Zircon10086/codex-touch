diff --git a/codex-rs/tui/src/bottom_pane/list_selection_view/touch.rs b/codex-rs/tui/src/bottom_pane/list_selection_view/touch.rs
new file mode 100644
index 0000000..7f1ff36
--- /dev/null
+++ b/codex-rs/tui/src/bottom_pane/list_selection_view/touch.rs
@@ -0,0 +1,266 @@
+//! Shared list taps select first and activate through the owner's existing key route.
+use super::*;
+use crate::keymap::ListAction;
+use crate::shortcut_touch::{Action as ShortcutAction, Outcome, Target};
+use crossterm::event::{MouseEvent, MouseEventKind};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Action {
+    Row(usize, Option<usize>, bool),
+    Tab(usize),
+    Keys(ShortcutHint),
+}
+
+pub(super) fn place_hint(target: Target, area: Rect) -> Option<Target<Action>> {
+    let ShortcutAction::Keys(hint) = target.action else {
+        return None;
+    };
+    if target
+        .areas
+        .iter()
+        .any(|rect| rect.right() > area.width || rect.bottom() > area.height)
+    {
+        return None;
+    }
+    Some(Target {
+        areas: target
+            .areas
+            .into_iter()
+            .map(|rect| Rect::new(area.x + rect.x, area.y + rect.y, rect.width, rect.height))
+            .collect(),
+        action: Action::Keys(hint),
+    })
+}
+
+impl ListSelectionView {
+    pub(super) fn touch_footer(&self, width: u16) -> (Vec<Line<'static>>, Vec<Target>) {
+        let mut hints = Vec::new();
+        for (action, label) in [
+            (ListAction::MoveUp, "up"),
+            (ListAction::MoveDown, "down"),
+            (ListAction::Accept, "select"),
+            (ListAction::Cancel, "back"),
+        ] {
+            if action == ListAction::Cancel && !self.allow_cancel {
+                continue;
+            }
+            if let Some(key) = self.keymap.primary_hint(action) {
+                hints.push((key, label));
+            }
+        }
+        if self.selected_item_has_toggle() {
+            let key = self
+                .search_toggle_key
+                .unwrap_or(crate::key_hint::plain(KeyCode::Char(' ')));
+            hints.push((key.into(), "toggle"));
+        }
+        if let Some(key) = self
+            .selected_actual_idx()
+            .and_then(|idx| self.active_items().get(idx))
+            .and_then(|item| item.secondary_action.as_ref())
+            .map(|action| action.key)
+        {
+            hints.push((key.into(), "more"));
+        }
+        if let SearchMode::OnDemand(key) = self.search_mode
+            && self.is_searchable
+            && !self.search_active
+        {
+            hints.push((key.into(), "search"));
+        }
+        if let Some(key) = self.header_view_all_hint {
+            hints.push((key, "view all"));
+        }
+        let mut keys = hints.iter().map(|(key, _)| *key).collect::<Vec<_>>();
+        keys.extend(super::super::picker_touch::list_hint_keys(&self.keymap));
+        keys.extend(self.touch_hint_keys.iter().copied());
+        let Some(line) = self.active_footer_hint().cloned() else {
+            return (Vec::new(), Vec::new());
+        };
+        crate::shortcut_help::wrap_rows(
+            vec![crate::touch_controls::known_hint_row(line, &keys)],
+            usize::from(width.max(1)),
+        )
+    }
+
+    pub(super) fn handle_list_touch(&mut self, event: MouseEvent) -> Outcome {
+        if !self.touch.borrow().enabled {
+            return Outcome::Ignored;
+        }
+        let outcome = self.touch.borrow_mut().handle(event);
+        match outcome {
+            Outcome::Activate(Action::Keys(key)) => Outcome::Activate(ShortcutAction::Keys(key)),
+            Outcome::Activate(Action::Tab(index)) => {
+                if let Some(active) = self.active_tab_idx {
+                    for _ in 0..self.tabs.len() {
+                        if self.active_tab_idx == Some(index) {
+                            break;
+                        }
+                        self.switch_tab(if index < active { -1 } else { 1 });
+                    }
+                }
+                self.touch.borrow_mut().clear();
+                Outcome::Consumed
+            }
+            Outcome::Activate(Action::Row(actual, tab, selected)) => {
+                if tab != self.active_tab_idx {
+                    return Outcome::Consumed;
+                }
+                let Some(index) = self.filtered_indices.iter().position(|&i| i == actual) else {
+                    return Outcome::Consumed;
+                };
+                if self.visible_idx_is_disabled(index) {
+                    return Outcome::Consumed;
+                }
+                let activate = selected && self.state.selected_idx == Some(index);
+                self.state.selected_idx = Some(index);
+                self.fire_selection_changed();
+                self.touch.borrow_mut().clear();
+                if activate && let Some(key) = self.keymap.primary_hint(ListAction::Accept) {
+                    Outcome::Activate(ShortcutAction::Keys(key))
+                } else {
+                    Outcome::Consumed
+                }
+            }
+            Outcome::Ignored
+                if matches!(
+                    event.kind,
+                    MouseEventKind::ScrollUp | MouseEventKind::ScrollDown
+                ) =>
+            {
+                // Wheel navigation uses the painted list only, not a side preview.
+                if self
+                    .touch
+                    .borrow()
+                    .contains(event, |action| matches!(action, Action::Row(..)))
+                {
+                    let action = if event.kind == MouseEventKind::ScrollUp {
+                        ListAction::MoveUp
+                    } else {
+                        ListAction::MoveDown
+                    };
+                    self.keymap
+                        .primary_hint(action)
+                        .map_or(Outcome::Consumed, |key| {
+                            Outcome::Activate(ShortcutAction::Keys(key))
+                        })
+                } else {
+                    Outcome::Ignored
+                }
+            }
+            Outcome::Ignored => Outcome::Ignored,
+            Outcome::Consumed => Outcome::Consumed,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::app_event::AppEvent;
+    use crate::keymap::RuntimeKeymap;
+    use crossterm::event::{KeyModifiers, MouseButton};
+
+    fn point(buf: &Buffer, label: &str) -> (u16, u16) {
+        for y in buf.area.y..buf.area.bottom() {
+            let row = (buf.area.x..buf.area.right())
+                .map(|x| buf[(x, y)].symbol())
+                .collect::<String>();
+            if let Some(x) = row.find(label) {
