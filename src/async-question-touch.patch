+use super::*;
+use crate::shortcut_touch::Outcome;
+use crossterm::event::KeyModifiers;
+use crossterm::event::MouseButton;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use tokio::sync::mpsc::unbounded_channel;
+
+fn fixture() -> StatusIndicatorWidget {
+    let (tx, _) = unbounded_channel();
+    let row = StatusIndicatorWidget::new(
+        AppEventSender::new(tx),
+        FrameRequester::test_dummy(),
+        false,
+        Default::default(),
+    );
+    row.shortcut_touch.borrow_mut().enabled = true;
+    row
+}
+
+fn draw(row: &StatusIndicatorWidget, width: u16) -> Buffer {
+    let area = Rect::new(3, 2, width, 4);
+    let mut buf = Buffer::empty(area);
+    row.with_timer(&StatusTimer::default())
+        .render(area, &mut buf);
+    buf
+}
+
+fn event(kind: MouseEventKind, buf: &Buffer) -> MouseEvent {
+    let x = (buf.area.x..buf.area.right())
+        .find(|&x| {
+            (x..buf.area.right())
+                .map(|x| buf[(x, 2)].symbol())
+                .collect::<String>()
+                .starts_with("to interrupt")
+        })
+        .unwrap();
+    MouseEvent {
+        kind,
+        column: x,
+        row: 2,
+        modifiers: KeyModifiers::NONE,
+    }
+}
+
+#[test]
+fn shortcut_interrupt_returns_runtime_binding_once() {
+    let mut row = fixture();
+    let hint = ShortcutHint::Chord {
+        prefix: key_hint::ctrl(KeyCode::Char('x')),
+        completion: key_hint::plain(KeyCode::Char('i')),
+    };
+    row.set_interrupt_binding(Some(hint));
+    row.update_header("正在工作".into());
+    let buf = draw(&row, 80);
+    assert_eq!(
+        row.shortcut_touch
+            .borrow_mut()
+            .handle(event(MouseEventKind::Down(MouseButton::Left), &buf)),
+        Outcome::Consumed
+    );
+    draw(&row, 80); // Same-layout timer/animation repaint must preserve a stationary tap.
+    let up = event(MouseEventKind::Up(MouseButton::Left), &buf);
+    assert_eq!(
+        row.shortcut_touch.borrow_mut().handle(up),
+        Outcome::Activate(Action::Keys(hint))
+    );
+    assert_eq!(row.shortcut_touch.borrow_mut().handle(up), Outcome::Ignored);
+}
+
+#[test]
+fn shortcut_interrupt_hidden_clipped_changed_and_dragged_never_activate() {
+    for change in 0..5 {
+        let mut row = fixture();
+        let buf = draw(&row, 80);
+        row.shortcut_touch
+            .borrow_mut()
+            .handle(event(MouseEventKind::Down(MouseButton::Left), &buf));
+        match change {
+            0 => row.set_interrupt_hint_visible(false),
+            1 => row.set_interrupt_binding(None),
+            2 => {
+                draw(&row, 20);
+            }
+            3 => {
+                row.shortcut_touch
+                    .borrow_mut()
+                    .handle(event(MouseEventKind::Drag(MouseButton::Left), &buf));
+            }
+            _ => {
+                row.update_header("Changed header".into());
+                draw(&row, 80);
+            }
+        }
+        assert_eq!(
+            row.shortcut_touch
+                .borrow_mut()
+                .handle(event(MouseEventKind::Up(MouseButton::Left), &buf)),
+            Outcome::Consumed
+        );
+    }
+    let row = fixture();
