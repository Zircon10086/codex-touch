+    pub(crate) fn handle_question_mouse(&mut self, event: crossterm::event::MouseEvent) -> bool {
+        let expanded = self
+            .bottom_pane
+            .questions
+            .as_ref()
+            .is_some_and(|q| q.expanded);
+        if self.bottom_pane.has_active_view()
+            || (!expanded && !self.bottom_pane.no_modal_or_popup_active())
+        {
+            if let Some(questions) = &mut self.bottom_pane.questions {
+                questions.invalidate_touch();
+            }
+            return false;
+        }
+        let Some(questions) = &mut self.bottom_pane.questions else {
+            return false;
+        };
+        if !questions.handle_touch(event) {
+            return false;
+        }
+        if let Some(key) = questions.touch_key.take() {
+            self.handle_question_key(key);
+        } else {
+            self.submit_pending_question_answer();
+        }
         self.request_redraw();
         true
     }
