+        .find_map(|(action, bindings)| {
+            (keymap.primary_hint(action, bindings) == Some(hint))
+                .then(|| bindings.first().copied())
+                .flatten()
+        }),
+    };
+    let Some(key) = key else {
+        return Outcome::Consumed;
+    };
+    Outcome::Activate(crate::shortcut_touch::key_event(
+        key,
+        crossterm::event::KeyEventKind::Press,
+    ))
+}
