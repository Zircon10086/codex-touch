+            .map(|col| buf[(col, row)].symbol())
+            .collect();
+        if let Some(index) = text.find(label) {
+            return (
+                unicode_width::UnicodeWidthStr::width(&text[..index]) as u16,
+                row,
+            );
+        }
+    }
