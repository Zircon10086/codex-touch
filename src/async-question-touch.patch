+#[tokio::test]
+async fn touch_question_delivery_preserves_draft_and_respects_queue_and_rejection() {
+    use crossterm::event::{MouseButton, MouseEvent, MouseEventKind};
+    for mode in 0..3 {
+        let (mut chat, _rx, mut ops) = make_chatwidget_manual(None).await;
+        open_questions(&mut chat, Some(vec!["Touch choice".into()]));
+        chat.bottom_pane.question_editor().touch_enabled = true;
+        chat.bottom_pane
+            .set_composer_text("main draft".into(), Vec::new(), Vec::new());
+        chat.input_queue.suppress_queue_autosend = mode == 1;
+        chat.blocks_direct_input = mode == 2;
+        let (column, row) = touch_question_at(&chat, "Touch choice");
+        for kind in [
+            MouseEventKind::Down(MouseButton::Left),
+            MouseEventKind::Up(MouseButton::Left),
+        ] {
+            assert!(chat.handle_question_mouse(MouseEvent {
+                kind,
+                column,
+                row,
+                modifiers: KeyModifiers::NONE
+            }));
+        }
+        assert_eq!(chat.bottom_pane.composer_text(), "main draft");
+        assert_eq!(question_count(&chat), if mode == 2 { 2 } else { 1 });
+        if mode == 0 {
+            assert_answer(ops.try_recv().unwrap(), "> First?\n\nTouch choice");
+        } else if mode == 1 {
+            assert_eq!(
+                chat.pop_latest_queued_composer_state().unwrap().text,
+                "> First?\n\nTouch choice"
+            );
+            assert!(ops.try_recv().is_err());
+        } else {
+            assert!(ops.try_recv().is_err());
+        }
+        // The release that delivered the first answer cannot act on the next question.
+        touch_question_at(&chat, if mode == 2 { "Touch choice" } else { "Second?" });
+        chat.handle_question_mouse(MouseEvent {
+            kind: MouseEventKind::Up(MouseButton::Left),
+            column,
+            row,
+            modifiers: KeyModifiers::NONE,
+        });
+        assert!(ops.try_recv().is_err());
+    }
