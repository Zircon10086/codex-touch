+
+fn touch_position(buf: &ratatui::buffer::Buffer, text: &str) -> (u16, u16) {
+    for y in buf.area.y..buf.area.bottom() {
+        for x in buf.area.x..buf.area.right() {
+            if (x..buf.area.right())
+                .map(|x| buf[(x, y)].symbol())
+                .collect::<String>()
+                .starts_with(text)
+            {
+                return (x, y);
+            }
+        }
+    }
+    panic!("missing {text}");
+}
+
+fn touch_event(
+    pos: (u16, u16),
+    kind: crossterm::event::MouseEventKind,
+) -> crossterm::event::MouseEvent {
+    crossterm::event::MouseEvent {
+        kind,
+        column: pos.0,
+        row: pos.1,
+        modifiers: KeyModifiers::NONE,
+    }
+}
+
+fn touch_draw(view: &AgentsOverviewView, width: u16, height: u16) -> ratatui::buffer::Buffer {
+    let area = Rect::new(2, 3, width, height);
+    let mut buf = ratatui::buffer::Buffer::empty(area);
+    view.render(area, &mut buf);
+    buf
+}
+
+fn touch_tap(view: &mut AgentsOverviewView, pos: (u16, u16)) -> crate::shortcut_touch::Outcome {
+    use crossterm::event::MouseButton;
+    use crossterm::event::MouseEventKind;
+    assert_eq!(
+        view.handle_shortcut_touch(touch_event(pos, MouseEventKind::Down(MouseButton::Left))),
+        crate::shortcut_touch::Outcome::Consumed
+    );
+    view.handle_shortcut_touch(touch_event(pos, MouseEventKind::Up(MouseButton::Left)))
+}
+
+fn touch_dispatch(view: &mut AgentsOverviewView, pos: (u16, u16)) {
+    if let crate::shortcut_touch::Outcome::Activate(crate::shortcut_touch::Action::Keys(
+        ShortcutHint::Single(key),
+    )) = touch_tap(view, pos)
+    {
+        view.handle_key_event(crate::shortcut_touch::key_event(
+            key,
+            crossterm::event::KeyEventKind::Press,
+        ));
+    }
+}
