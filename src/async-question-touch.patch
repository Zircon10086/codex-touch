+    #[tokio::test]
+    async fn footer_density_and_cancel_are_touch_actions() {
+        let mut state = fixture();
+        paint(&state, 110, 38);
+        tap(&mut state, |a| {
+            a == Action::Keys(crate::key_hint::ctrl(KeyCode::Char('o')).into())
