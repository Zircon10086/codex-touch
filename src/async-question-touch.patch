@@ -0,0 +1,227 @@
+//! Composer hint taps use the same runtime bindings as the keyboard. Opening
+//! help by touch also works with a draft; typing `?` retains its original meaning.
+use super::*;
+use crate::shortcut_touch::Action;
+use crate::shortcut_touch::Outcome;
+
+impl ChatComposer {
+    pub(crate) fn shortcut_touch_active(&self) -> bool {
+        match &self.popups.active {
+            ActivePopup::Command(popup) => popup.touch_active(),
+            ActivePopup::File(popup) => popup.touch_active(),
+            ActivePopup::Skill(popup) => popup.touch_active(),
+            ActivePopup::MentionV2(popup) => popup.touch_active(),
+            ActivePopup::None => self.footer.shortcut_touch.borrow().active(),
+        }
+    }
+
+    pub(crate) fn cancel_shortcut_touch(&self) {
+        self.footer.shortcut_touch.borrow_mut().clear();
+        match &self.popups.active {
+            ActivePopup::Command(popup) => popup.cancel_touch(),
+            ActivePopup::File(popup) => popup.cancel_touch(),
+            ActivePopup::Skill(popup) => popup.cancel_touch(),
+            ActivePopup::MentionV2(popup) => popup.cancel_touch(),
+            _ => {}
+        }
+    }
+
+    pub(crate) fn handle_shortcut_touch(&mut self, mouse: crossterm::event::MouseEvent) -> Outcome {
+        match &mut self.popups.active {
+            ActivePopup::Command(popup) => return popup.handle_touch(mouse),
+            ActivePopup::File(popup) => return popup.handle_touch(mouse),
+            ActivePopup::Skill(popup) => return popup.handle_touch(mouse),
+            ActivePopup::MentionV2(popup) => return popup.handle_touch(mouse),
+            _ => {}
+        }
+        let outcome = self.footer.shortcut_touch.get_mut().handle(mouse);
+        if let Outcome::Activate(action) = outcome {
+            self.clear_mouse_selection();
+            match action {
+                Action::Help => {
+                    self.footer.mode = FooterMode::ShortcutOverlay;
+                    self.footer.shortcut_touch.borrow_mut().clear();
+                    return Outcome::Consumed;
+                }
+                Action::Close => {
+                    self.footer.mode = reset_mode_after_activity(self.footer.mode);
+                    self.footer.shortcut_touch.borrow_mut().clear();
+                    return Outcome::Consumed;
+                }
+                Action::Keys(_) | Action::Keymap => {
+                    // Dismiss help directly: a synthetic Escape could backtrack a conversation.
+                    if self.footer.mode == FooterMode::ShortcutOverlay {
+                        self.footer.mode = reset_mode_after_activity(self.footer.mode);
+                    }
+                    self.footer.shortcut_touch.borrow_mut().clear();
+                }
+            }
+        }
+        outcome
+    }
+}
