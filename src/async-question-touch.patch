+//! Geometry and gesture handling shared by specialized settings and question lists.
+use super::selection_popup_common::{GenericDisplayRow, RowRegion};
+use crate::key_hint::ShortcutHint;
+use crate::shortcut_touch::{Outcome, ShortcutTouch, Target};
+use crossterm::event::{MouseEvent, MouseEventKind};
+use ratatui::layout::Rect;
+use ratatui::text::Line;
+use std::cell::RefCell;
+use std::hash::{Hash, Hasher};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Action {
+    Row(usize, u64),
+    Keys(ShortcutHint),
+}
+pub(super) struct PickerTouch {
+    state: RefCell<ShortcutTouch<Action>>,
+    targets: RefCell<Vec<Target<Action>>>,
+}
+impl Default for PickerTouch {
+    fn default() -> Self {
+        Self {
+            state: RefCell::new(ShortcutTouch::new()),
+            targets: RefCell::new(Vec::new()),
+        }
+    }
+}
+impl PickerTouch {
+    #[cfg(test)]
+    pub(crate) fn enable_for_test(&self) {
+        self.state.borrow_mut().enabled = true;
+    }
+
+    pub(crate) fn register_row(&self, index: usize, identity: &str, area: Rect) {
+        let mut hash = std::collections::hash_map::DefaultHasher::new();
+        identity.hash(&mut hash);
+        self.targets
+            .borrow_mut()
+            .push(Target::new(area, Action::Row(index, hash.finish())));
+    }
+
+    pub(super) fn enabled(&self) -> bool {
+        self.state.borrow().enabled
+    }
+    pub(super) fn active(&self) -> bool {
+        self.state.borrow().active()
+    }
+    pub(super) fn cancel(&self) {
+        self.state.borrow_mut().cancel();
+    }
+    pub(super) fn begin(&self) {
+        self.targets.borrow_mut().clear();
+    }
+    pub(super) fn finish(&self, area: Rect) {
+        self.state
+            .borrow_mut()
+            .set_layout(area, self.targets.borrow().clone());
+    }
+    pub(super) fn rows(&self, regions: Vec<RowRegion>, rows: &[GenericDisplayRow]) {
+        for region in regions {
+            let Some(row) = rows.get(region.index) else {
+                continue;
+            };
+            if row.is_disabled || row.disabled_reason.is_some() {
+                continue;
+            }
+            let mut hash = std::collections::hash_map::DefaultHasher::new();
+            row.name.hash(&mut hash);
+            row.description.hash(&mut hash);
+            for span in &row.name_prefix_spans {
+                span.content.hash(&mut hash);
+            }
+            self.targets.borrow_mut().push(Target::new(
+                region.area,
+                Action::Row(region.index, hash.finish()),
+            ));
+        }
+    }
+    pub(super) fn hint(&self, line: Line<'static>, keys: &[ShortcutHint], area: Rect) {
+        let (_, targets) = crate::shortcut_help::wrap_rows(
+            vec![crate::touch_controls::known_hint_row(line, keys)],
+            usize::from(area.width.max(1)),
+        );
+        self.targets
+            .borrow_mut()
+            .extend(targets.into_iter().filter_map(|t| {
+                if t.areas
+                    .iter()
+                    .any(|r| r.bottom() > area.height || r.right() > area.width)
+                {
+                    return None;
+                }
+                let crate::shortcut_touch::Action::Keys(key) = t.action else {
+                    return None;
+                };
+                Some(Target {
+                    areas: t
+                        .areas
+                        .into_iter()
+                        .map(|r| Rect::new(area.x + r.x, area.y + r.y, r.width, r.height))
+                        .collect(),
+                    action: Action::Keys(key),
+                })
+            }));
+    }
+    pub(super) fn handle(
+        &self,
+        event: MouseEvent,
+        up: Option<ShortcutHint>,
+        down: Option<ShortcutHint>,
+    ) -> Outcome<Action> {
+        let mut state = self.state.borrow_mut();
+        let result = state.handle(event);
+        if result == Outcome::Ignored && state.contains(event, |a| matches!(a, Action::Row(..))) {
+            let key = match event.kind {
+                MouseEventKind::ScrollUp => up,
+                MouseEventKind::ScrollDown => down,
+                _ => None,
+            };
+            if let Some(key) = key {
+                return Outcome::Activate(Action::Keys(key));
+            }
+        }
+        result
+    }
+}
+
+pub(crate) fn list_hint_keys(keymap: &crate::keymap::ListKeymap) -> Vec<ShortcutHint> {
+    use crate::keymap::ListAction::*;
+    [
+        MoveUp, MoveDown, MoveLeft, MoveRight, PageUp, PageDown, JumpTop, JumpBottom, Accept,
+        Cancel,
+    ]
+    .into_iter()
+    .filter_map(|a| keymap.primary_hint(a))
+    .chain([crate::key_hint::plain(crossterm::event::KeyCode::Char(' ')).into()])
+    .collect()
+}
