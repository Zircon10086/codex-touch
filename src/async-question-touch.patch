index 0000000..ba7df05
--- /dev/null
+++ b/codex-rs/tui/src/touch_controls.rs
@@ -0,0 +1,529 @@
+//! Small rendered controls shared by standalone prompts. Actions stay with the owner.
+use crate::key_hint::ShortcutHint;
+use crate::render::renderable::Renderable;
+use crate::shortcut_touch::{Action, Outcome, ShortcutTouch, Target};
+use crate::tui::TuiEvent;
+use crossterm::event::{KeyCode, KeyEvent, KeyEventKind, MouseEventKind};
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::widgets::{Paragraph, Widget};
+use std::cell::RefCell;
+use std::rc::Rc;
+
+#[derive(Clone)]
+pub(crate) struct TouchControls(Rc<RefCell<State>>);
+struct State {
+    touch: ShortcutTouch,
+    area: Rect,
+    targets: Vec<Target>,
+}
+impl Default for TouchControls {
+    fn default() -> Self {
+        Self(Rc::new(RefCell::new(State {
+            touch: ShortcutTouch::new(),
+            area: Rect::default(),
+            targets: Vec::new(),
+        })))
+    }
+}
+impl TouchControls {
+    #[cfg(test)]
+    pub(crate) fn enable_for_test(&self) {
+        self.0.borrow_mut().touch.enabled = true;
+    }
+
+    pub(crate) fn begin(&self, area: Rect) {
+        let mut state = self.0.borrow_mut();
+        state.area = area;
+        state.targets.clear();
+    }
+    pub(crate) fn finish(&self) {
+        let mut state = self.0.borrow_mut();
+        let area = state.area;
+        let targets = state.targets.clone();
+        state.touch.set_layout(area, targets);
+    }
+    pub(crate) fn register(&self, area: Rect, key: impl Into<ShortcutHint>) {
+        if !area.is_empty() {
+            self.0
+                .borrow_mut()
+                .targets
+                .push(Target::new(area, Action::Keys(key.into())));
+        }
+    }
+    pub(crate) fn cancel(&self) {
+        self.0.borrow_mut().touch.cancel();
+    }
+    pub(crate) fn enabled(&self) -> bool {
+        self.0.borrow().touch.enabled
+    }
+    pub(crate) fn active(&self) -> bool {
+        self.0.borrow().touch.active()
+    }
+    pub(crate) fn handle(&self, event: crossterm::event::MouseEvent) -> Outcome {
+        self.0.borrow_mut().touch.handle(event)
+    }
+    pub(crate) fn input(&self, event: &TuiEvent) -> Vec<KeyEvent> {
+        match event {
+            TuiEvent::Mouse(mouse) => {
+                let mut state = self.0.borrow_mut();
+                match state.touch.handle(*mouse) {
+                    Outcome::Activate(Action::Keys(hint)) => key_events(hint),
+                    Outcome::Ignored
+                        if matches!(
+                            mouse.kind,
+                            MouseEventKind::ScrollUp | MouseEventKind::ScrollDown
+                        ) && state.touch.contains(*mouse, |_| true) =>
+                    {
+                        key_events(
+                            crate::key_hint::plain(if mouse.kind == MouseEventKind::ScrollUp {
+                                KeyCode::Up
+                            } else {
+                                KeyCode::Down
+                            })
+                            .into(),
+                        )
+                    }
+                    _ => Vec::new(),
+                }
+            }
+            TuiEvent::Draw => Vec::new(),
+            _ => {
+                self.cancel();
+                Vec::new()
+            }
+        }
+    }
+    pub(crate) fn hints(&self, hints: Vec<(ShortcutHint, &'static str)>) -> Hints {
+        Hints {
+            controls: self.clone(),
+            hints,
+        }
+    }
+}
+pub(crate) fn key_events(hint: ShortcutHint) -> Vec<KeyEvent> {
+    let keys = match hint {
+        ShortcutHint::Single(key) => vec![key],
+        ShortcutHint::Chord { prefix, completion } => vec![prefix, completion],
+    };
+    keys.into_iter()
+        .flat_map(|key| {
+            [KeyEventKind::Press, KeyEventKind::Release]
+                .map(|kind| crate::shortcut_touch::key_event(key, kind))
+        })
+        .collect()
+}
+pub(crate) struct Hints {
+    controls: TouchControls,
+    hints: Vec<(ShortcutHint, &'static str)>,
+}
+impl Hints {
+    fn rows(&self, width: u16) -> (Vec<ratatui::text::Line<'static>>, Vec<Target>) {
+        let mut row = crate::shortcut_help::HelpRow::default();
+        for (key, label) in &self.hints {
+            if !row.line.spans.is_empty() {
+                row.line.push_span(" · ");
+            }
+            let start = row.line.spans.iter().map(|span| span.content.len()).sum();
+            row.line.extend(key.spans());
+            row.line.push_span(format!(" {label}"));
+            let end = row.line.spans.iter().map(|span| span.content.len()).sum();
+            row.hints.push((start..end, *key));
+        }
+        crate::shortcut_help::wrap_rows(vec![row], usize::from(width.max(1)))
+    }
+}
+impl Renderable for Hints {
+    fn desired_height(&self, width: u16) -> u16 {
+        self.rows(width).0.len() as u16
+    }
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let (rows, targets) = self.rows(area.width);
+        Paragraph::new(rows).render(area, buf);
+        for target in targets {
+            if target
+                .areas
+                .iter()
+                .any(|rect| rect.right() > area.width || rect.bottom() > area.height)
+            {
+                continue;
+            }
+            let areas = target
+                .areas
+                .iter()
+                .map(|r| Rect::new(area.x + r.x, area.y + r.y, r.width, r.height))
+                .collect();
+            self.controls.0.borrow_mut().targets.push(Target {
+                areas,
+                action: target.action,
+            });
+        }
+    }
+}
+
+/// Map only caller-supplied bindings to a trusted hint line. Keys are rendered
+/// forward from semantic bindings; terminal contents never become key input.
+pub(crate) fn known_hint_row(
+    line: ratatui::text::Line<'static>,
+    keys: &[ShortcutHint],
+) -> crate::shortcut_help::HelpRow {
+    let text = line.to_string();
+    let lower = text.to_ascii_lowercase();
+    let mut found = Vec::new();
+    for key in keys {
+        let mut labels = vec![key.display_label()];
+        let mut insensitive = true;
+        if let ShortcutHint::Single(binding) = key {
+            let (code, modifiers) = binding.parts();
+            insensitive = !matches!(code, KeyCode::Char(ch) if ch.is_ascii_alphabetic());
+            if let KeyCode::Char(ch) = code
+                && modifiers == crossterm::event::KeyModifiers::SHIFT
+            {
+                labels.push(ch.to_ascii_uppercase().to_string());
+            }
+            if modifiers.is_empty() {
+                let alias = match code {
+                    KeyCode::Up => Some("up"),
+                    KeyCode::Down => Some("down"),
+                    KeyCode::Left => Some("left"),
+                    KeyCode::Right => Some("right"),
+                    KeyCode::PageUp => Some("pgup"),
+                    KeyCode::PageDown => Some("pgdn"),
+                    _ => None,
+                };
+                if let Some(alias) = alias {
+                    labels.push(alias.into());
+                }
+            }
+        }
+        for label in labels {
+            let label = if insensitive {
+                label.to_ascii_lowercase()
+            } else {
+                label
+            };
+            let haystack = if insensitive { &lower } else { &text };
+            for (start, _) in haystack.match_indices(&label) {
+                let end = start + label.len();
+                let word = |c: char| c.is_alphanumeric() || c == '_' || c == '+' || c == '⌃';
+                if label.chars().next().is_some_and(word)
+                    && text[..start].chars().next_back().is_some_and(word)
+                {
+                    continue;
+                }
+                if label.chars().last().is_some_and(word)
+                    && text[end..].chars().next().is_some_and(word)
+                {
+                    continue;
+                }
+                found.push((start, end, *key));
+            }
+        }
+    }
+    found.sort_by_key(|(start, end, _)| (*start, std::cmp::Reverse(*end)));
+    // Prefer the complete chord when its completion also appears among candidates.
+    let mut previous_end = 0;
+    found.retain(|(start, end, _)| {
+        if *start < previous_end {
+            return false;
+        }
+        previous_end = *end;
+        true
+    });
+    let mut hints = Vec::new();
+    for (index, (start, key_end, key)) in found.iter().enumerate() {
+        let next = found
+            .get(index + 1)
+            .map_or(text.len(), |(start, _, _)| *start);
+        if *key_end > next {
+            continue;
+        }
+        let tail = &text[*key_end..next];
+        let separator = tail
+            .find(" · ")
+            .or_else(|| tail.find(" | "))
+            .or_else(|| tail.find(" or "))
+            .or_else(|| tail.find('/'));
+        let end = separator.map_or(next, |offset| key_end + offset);
+        hints.push((*start..end, *key));
+    }
+    crate::shortcut_help::HelpRow { line, hints }
+}
+impl TouchControls {
+    pub(crate) fn register_hint_line(
+        &self,
+        line: ratatui::text::Line<'static>,
+        keys: &[ShortcutHint],
+        area: Rect,
+    ) {
+        let (_, targets) = crate::shortcut_help::wrap_rows(
+            vec![known_hint_row(line, keys)],
+            usize::from(area.width.max(1)),
+        );
+        for target in targets {
+            if target
+                .areas
+                .iter()
+                .any(|rect| rect.right() > area.width || rect.bottom() > area.height)
+            {
+                continue;
+            }
+            self.0.borrow_mut().targets.push(Target {
+                areas: target
+                    .areas
+                    .iter()
+                    .map(|r| Rect::new(area.x + r.x, area.y + r.y, r.width, r.height))
+                    .collect(),
+                action: target.action,
+            });
+        }
+    }
+}
+
+/// Translate a standalone list's semantic action through its runtime chord map.
+/// The surrounding screen still owns confirmation, persistence, and dismissal.
+pub(crate) fn view_event(
+    event: TuiEvent,
+    view: &mut dyn crate::bottom_pane::BottomPaneView,
+    keymap: &crate::keymap::RuntimeKeymap,
+    matcher: &mut crate::keymap::KeyChordMatcher,
+) -> Option<TuiEvent> {
+    let TuiEvent::Mouse(mouse) = event else {
+        if !matches!(event, TuiEvent::Draw) {
+            view.cancel_shortcut_touch();
+        }
+        return Some(event);
+    };
+    match view.handle_shortcut_touch(mouse) {
+        Outcome::Activate(Action::Keys(hint)) => {
+            matcher.cancel();
+            let mut result = None;
+            for key in key_events(hint) {
+                match matcher.advance(key, &keymap.chords, view.keymap_contexts()) {
+                    crate::keymap::KeyChordMatch::PassThrough
+                        if key.kind == KeyEventKind::Press =>
+                    {
+                        result = Some(key)
+                    }
+                    crate::keymap::KeyChordMatch::Completed(key) => result = Some(key),
+                    _ => {}
+                }
+            }
+            result.map(TuiEvent::Key)
+        }
+        Outcome::Consumed => None,
+        _ => Some(TuiEvent::Mouse(mouse)),
+    }
+}
+
+/// Bind UI-authored transcript navigation (never the editable search query).
+pub(crate) fn transcript_hint_keys() -> Vec<ShortcutHint> {
+    use crate::key_hint::{ctrl, plain, shift};
+    [
+        KeyCode::Up,
+        KeyCode::Down,
+        KeyCode::Left,
+        KeyCode::Right,
+        KeyCode::Home,
+        KeyCode::End,
+        KeyCode::PageUp,
+        KeyCode::PageDown,
+        KeyCode::Enter,
+        KeyCode::Esc,
+        KeyCode::Tab,
+    ]
+    .into_iter()
+    .map(|k| plain(k).into())
+    .chain(
+        "hjklwbeg0$vo/nyq "
+            .chars()
+            .map(|ch| plain(KeyCode::Char(ch)).into()),
+    )
+    .chain(
+        [
+            ctrl(KeyCode::Char('c')),
+            ctrl(KeyCode::Char(' ')),
+            ctrl(KeyCode::Home),
+            ctrl(KeyCode::End),
+            shift(KeyCode::Char('g')),
+            shift(KeyCode::Char('v')),
+            shift(KeyCode::Char('n')),
+        ]
+        .into_iter()
+        .map(Into::into),
+    )
+    .collect()
+}
+
+pub(crate) fn hint_targets(
+    line: ratatui::text::Line<'static>,
+    keys: &[ShortcutHint],
+    area: Rect,
+) -> Vec<Target> {
+    let (_, targets) = crate::shortcut_help::wrap_rows(
+        vec![known_hint_row(line, keys)],
+        usize::from(area.width.max(1)),
+    );
+    targets
+        .into_iter()
+        .filter_map(|target| {
+            if target
+                .areas
+                .iter()
+                .any(|r| r.right() > area.width || r.bottom() > area.height)
+            {
+                return None;
+            }
+            Some(Target {
+                areas: target
+                    .areas
+                    .into_iter()
+                    .map(|r| Rect::new(area.x + r.x, area.y + r.y, r.width, r.height))
+                    .collect(),
+                action: target.action,
+            })
+        })
+        .collect()
+}
+
+#[cfg(test)]
+pub(crate) mod tests {
+    use super::*;
+    use crate::bottom_pane::BottomPaneView;
+    use crossterm::event::{KeyModifiers, MouseButton, MouseEvent, MouseEventKind};
+    pub(crate) fn point(buf: &Buffer, label: &str) -> (u16, u16) {
+        for y in buf.area.y..buf.area.bottom() {
+            for x in buf.area.x..buf.area.right() {
+                let row: String = (x..buf.area.right())
+                    .map(|x| crate::terminal_hyperlinks::strip_osc8(buf[(x, y)].symbol()))
+                    .collect();
+                if row.starts_with(label) {
+                    return (x, y);
+                }
+            }
+        }
+        panic!("Missing control {label}");
+    }
+    pub(crate) fn mouse(pos: (u16, u16), kind: MouseEventKind) -> MouseEvent {
+        MouseEvent {
+            kind,
+            column: pos.0,
+            row: pos.1,
+            modifiers: KeyModifiers::NONE,
+        }
+    }
+    pub(crate) fn tap(view: &mut dyn BottomPaneView, pos: (u16, u16)) -> Outcome {
+        assert_eq!(
+            view.handle_shortcut_touch(mouse(pos, MouseEventKind::Down(MouseButton::Left))),
+            Outcome::Consumed
+        );
+        view.handle_shortcut_touch(mouse(pos, MouseEventKind::Up(MouseButton::Left)))
+    }
+    pub(crate) fn activate(view: &mut dyn BottomPaneView, pos: (u16, u16)) {
+        if let Outcome::Activate(Action::Keys(hint)) = tap(view, pos) {
+            for key in key_events(hint)
+                .into_iter()
+                .filter(|key| key.kind == KeyEventKind::Press)
+            {
+                view.handle_key_event(key);
+            }
+        }
+    }
+    #[test]
+    fn touch_hint_matching_preserves_chords_modifiers_and_unbound_text() {
+        let ctrl = crate::key_hint::ctrl(KeyCode::Char('c'));
+        let key = crate::key_hint::plain(KeyCode::Char('c'));
+        let chord = ShortcutHint::Chord {
+            prefix: ctrl,
+            completion: key,
+        };
+        let line = ratatui::text::Line::from(format!(
+            "{} do action · Esc back · arbitrary prose",
+            chord.display_label()
+        ));
+        let row = known_hint_row(
+            line,
+            &[
+                ctrl.into(),
+                key.into(),
+                chord,
+                crate::key_hint::plain(KeyCode::Esc).into(),
+            ],
+        );
+        assert_eq!(row.hints.len(), 2);
+        assert_eq!(row.hints[0].1, chord);
+        assert_eq!(&row.line.to_string()[row.hints[1].0.clone()], "Esc back");
+        assert!(
+            known_hint_row("No shortcut supplied".into(), &[])
+                .hints
+                .is_empty()
+        );
+    }
+    #[test]
+    fn touch_hint_wrapping_drag_resize_and_default_off() {
+        let controls = TouchControls::default();
+        let area = Rect::new(2, 3, 24, 5);
+        let render = |area| {
+            let mut buf = Buffer::empty(area);
+            controls.begin(area);
+            controls
+                .hints(vec![
+                    (
+                        crate::key_hint::shift(KeyCode::Tab).into(),
+                        "previous question",
+                    ),
+                    (crate::key_hint::plain(KeyCode::Enter).into(), "confirm"),
+                ])
+                .render(area, &mut buf);
+            controls.finish();
+            buf
+        };
+        let buf = render(area);
+        let pos = point(&buf, "previous");
+        assert_eq!(
+            controls.handle(mouse(pos, MouseEventKind::Down(MouseButton::Left))),
+            Outcome::Ignored
+        );
+        controls.enable_for_test();
+        assert_eq!(
+            controls.handle(mouse(pos, MouseEventKind::Down(MouseButton::Left))),
+            Outcome::Consumed
+        );
+        controls.handle(mouse(pos, MouseEventKind::Drag(MouseButton::Left)));
+        assert_eq!(
+            controls.handle(mouse(pos, MouseEventKind::Up(MouseButton::Left))),
+            Outcome::Consumed
+        );
+        controls.handle(mouse(pos, MouseEventKind::Down(MouseButton::Left)));
+        render(Rect { width: 20, ..area });
+        assert_eq!(
+            controls.handle(mouse(pos, MouseEventKind::Up(MouseButton::Left))),
+            Outcome::Consumed
+        );
+        let buf = render(area);
+        let pos = point(&buf, "confirm");
+        controls.handle(mouse(pos, MouseEventKind::Down(MouseButton::Left)));
+        assert_eq!(
+            controls.handle(mouse(pos, MouseEventKind::Up(MouseButton::Left))),
+            Outcome::Activate(Action::Keys(crate::key_hint::plain(KeyCode::Enter).into()))
+        );
+    }
+}
+
+/// Attach one semantic action to an existing renderable without changing its layout.
+pub(crate) struct Control {
+    pub(crate) child: Box<dyn Renderable>,
+    pub(crate) controls: TouchControls,
+    pub(crate) key: ShortcutHint,
+}
+impl Renderable for Control {
+    fn desired_height(&self, width: u16) -> u16 {
+        self.child.desired_height(width)
+    }
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        self.child.render(area, buf);
+        if self.child.desired_height(area.width) <= area.height {
+            self.controls.register(area, self.key);
+        }
+    }
+}
