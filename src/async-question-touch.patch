+fn pager_touch_key(
+    touch: &crate::touch_controls::TouchControls,
+    event: &TuiEvent,
+    keymap: &PagerKeymap,
+) -> crate::shortcut_touch::Outcome<KeyEvent> {
+    use crate::shortcut_touch::{Action, Outcome};
+    let TuiEvent::Mouse(mouse) = event else {
+        if !matches!(event, TuiEvent::Draw) {
+            touch.cancel();
+        }
+        return Outcome::Ignored;
+    };
+    let hint = match touch.handle(*mouse) {
+        Outcome::Activate(Action::Keys(hint)) => hint,
+        Outcome::Ignored => return Outcome::Ignored,
+        _ => return Outcome::Consumed,
+    };
+    let key = match hint {
+        ShortcutHint::Single(key) => Some(key),
+        ShortcutHint::Chord { .. } => [
+            ("scroll_up", &keymap.scroll_up),
+            ("scroll_down", &keymap.scroll_down),
+            ("page_up", &keymap.page_up),
+            ("page_down", &keymap.page_down),
+            ("jump_top", &keymap.jump_top),
+            ("jump_bottom", &keymap.jump_bottom),
