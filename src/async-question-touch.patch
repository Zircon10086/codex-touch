+fn touch_question_at(chat: &ChatWidget, label: &str) -> (u16, u16) {
+    let area = Rect::new(0, 0, 80, chat.desired_height(80));
+    let mut buf = Buffer::empty(area);
+    chat.render(area, &mut buf);
+    for row in 0..area.height {
