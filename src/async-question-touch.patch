+#[tokio::test]
+async fn live_center_touch_refresh_drag_resize_and_cover_cancel() {
+    use crossterm::event::MouseButton;
+    use crossterm::event::MouseEventKind;
+    let app = make_test_app_with_chat().await;
+    let ids = [ThreadId::from_u128(703), ThreadId::from_u128(704)];
+    let threads = vec![
+        overview_thread(ids[0], None, "Alpha task", ThreadStatus::Idle),
+        overview_thread(ids[1], None, "Bravo task", ThreadStatus::Idle),
+    ];
+    for change in 0..5 {
+        let mut view = app.agents_overview_view(threads.clone(), Some(ids[0]));
+        view.enable_shortcut_touch_for_test();
+        let buf = touch_draw(&view, 100, 30);
+        let pos = touch_position(&buf, "Alpha task");
+        view.handle_shortcut_touch(touch_event(pos, MouseEventKind::Down(MouseButton::Left)));
+        match change {
+            0 => {
+                touch_draw(&view, 99, 30);
+            }
+            1 => {
+                view.handle_shortcut_touch(touch_event(
+                    pos,
+                    MouseEventKind::Drag(MouseButton::Left),
+                ));
+            }
+            2 => {
+                view.cancel_shortcut_touch();
+                touch_draw(&view, 100, 30);
+            }
+            3 => {
+                view = app.agents_overview_view(threads.clone(), Some(ids[0]));
+                view.enable_shortcut_touch_for_test();
+                touch_draw(&view, 100, 30);
+            }
+            _ => {
+                view.rows.swap(0, 1);
+                touch_draw(&view, 100, 30);
+            }
+        }
+        let outcome =
+            view.handle_shortcut_touch(touch_event(pos, MouseEventKind::Up(MouseButton::Left)));
+        if change == 3 {
+            assert!(matches!(
+                outcome,
+                crate::shortcut_touch::Outcome::Activate(_)
+            ));
+        } else {
+            assert_eq!(outcome, crate::shortcut_touch::Outcome::Consumed);
+        }
+    }
+}
